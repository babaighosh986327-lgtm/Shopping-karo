rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'bg5684017@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Products collection: public can read active, admin can manage all
    match /products/{productId} {
      allow get: if resource.data.active == true || isAdmin();
      allow list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if resource.data.active == true || isAdmin();
      allow list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Global Store Settings
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // User Shopping Carts
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders: Anyone can create order; Owner or Admin can read; Admin can update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid) || resource.data.customerId == 'guest';
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
