# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Razorpay Gateway Integration Keys (if using live payment processing):
# In preview mode, LUXEBAG operates with an integrated sandbox simulator.
# For production live cards and UPI, configure your Razorpay Key ID and Key Secret:
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"

# Administrator Account:
# The default bootstrapped store administrator is: bg5684017@gmail.com
# Additional administrators can be granted in Firestore 'admins' or 'users' collection.
